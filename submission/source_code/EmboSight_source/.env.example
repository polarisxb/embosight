# ============================================================
# EmboSight 环境变量配置示例
# ============================================================
# 用法:
#   1. cp .env.example .env
#   2. 编辑 .env 填入实际 API Key
#   3. 不要把 .env 提交到 git（已在 .gitignore 中）
# ============================================================

# DeepSeek API Key
# 申请地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek API Base URL（默认即可，如需切换其他兼容 API 可修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# DeepSeek 模型名称（deepseek-chat 普通版 / deepseek-reasoner 推理版）
DEEPSEEK_MODEL=deepseek-chat

# 可选: HuggingFace Token（下载受限模型时使用）
# HF_TOKEN=your_hf_token

# 可选: HuggingFace 镜像（中国大陆建议设置）
HF_ENDPOINT=https://hf-mirror.com

# 可选: 其他 LLM API
# OPENAI_API_KEY=
# QWEN_API_KEY=
# GLM_API_KEY=

# 项目运行参数
PROJECT_ROOT=.
LOG_LEVEL=INFO